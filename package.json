{
  "name": "coin-maker-countdown",
  "version": "0.1.0",
  "private": true,
  "description": "A local web companion and desktop countdown for Coin Maker Simulator",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:run": "npm run test:run --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm run format:check"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsumi-gabgab/Coin-Maker-Countdown.git"
  },
  "keywords": [],
  "author": "itsumi-gabgab",
  "type": "module",
  "bugs": {
    "url": "https://github.com/itsumi-gabgab/Coin-Maker-Countdown/issues"
  },
  "homepage": "https://github.com/itsumi-gabgab/Coin-Maker-Countdown#readme",
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
